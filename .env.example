# Copy to .env (cp .env.example .env). Compose, the API dev server and Drizzle Kit read it.

# --- Development (pnpm db:up / pnpm dev) ---
# Host port of the dev database. Change it if 5432 is already in use.
DB_PORT=5432

# --- Sign-in (development and production) ---
# Signs sessions and cookies. Optional in development (a built-in default is used, with a
# warning); required in production. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Where people open the web app. Development default: http://localhost:3000
# BETTER_AUTH_URL=https://buildinio.example.com
# Google sign-in: create an OAuth client ID (type "Web application") in Google Cloud Console,
# APIs & Services > Credentials, with the authorized redirect URI
# <BETTER_AUTH_URL>/api/auth/callback/google (http://localhost:3000/api/auth/callback/google in
# development). Without both keys, "Continue with Google" says it isn't set up.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub sign-in: create an OAuth app in GitHub, Settings > Developer settings > OAuth Apps, with
# the authorization callback URL <BETTER_AUTH_URL>/api/auth/callback/github
# (http://localhost:3000/api/auth/callback/github in development), then generate a client secret.
# An OAuth app has one callback URL, so use one app for development and another for production.
# Without both keys, "Continue with GitHub" says it isn't set up.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Production (pnpm prod:up) ---
# Required. Use a strong password.
POSTGRES_PASSWORD=change-me
# Host port the web app is published on.
WEB_PORT=3000
