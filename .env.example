# Buildinio's settings. `npm run setup` (or scripts/host.sh) copies this file to .env.local
# and fills in the AI for you. Restart Buildinio after changing anything here.
# Only the AI is needed: anything left empty shows a message instead of working.

# ── The AI ──────────────────────────────────────────────────────────────────────

# The AI that builds the apps: an OpenAI model. Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Any model that works with the Responses API and function calling.
OPENAI_MODEL=gpt-6-luna
# How hard it thinks, passed to OpenAI as is: none, minimal, low, medium, high, xhigh or max,
# depending on the model. Empty uses the model's default.
OPENAI_REASONING_EFFORT=medium
# Optional: a cheaper model (and its effort) for quick side jobs, like naming a new project.
# Empty uses the main model.
OPENAI_SMALL_MODEL=
OPENAI_SMALL_REASONING_EFFORT=

# ── Where the AI's commands run ─────────────────────────────────────────────────

# docker (default): a throwaway container that only sees the app's folder. Needs Docker running.
# host: right on this computer, with nothing secret in its environment. No setup, but no isolation either.
SANDBOX=docker
# For SANDBOX=docker: the container image. Empty uses Playwright's image matching playwright-core
# (Node, npm and Chromium). The AI's screenshots always use that image, whatever this says.
SANDBOX_IMAGE=
# For SANDBOX=host: the Chromium for screenshots. Empty uses Playwright's, downloaded the first time.
CHROMIUM_PATH=

# ── The address ─────────────────────────────────────────────────────────────────

# Where people open Buildinio, without a / at the end. Google and GitHub send people back here
# after they sign in, and emails link to it. scripts/host.sh sets it to your https:// address.
APP_URL=http://localhost:3000

# ── Sign-in (optional) ──────────────────────────────────────────────────────────
# Callback addresses below are for your computer: when hosting, use your APP_URL instead of
# http://localhost:3000.

# Google: https://console.cloud.google.com/apis/credentials (OAuth client ID, "Web application")
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub: https://github.com/settings/developers (New OAuth App)
# Authorization callback URL: http://localhost:3000/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Email codes are sent with Resend: https://resend.com/api-keys
# Without a key, codes are printed in the server console instead.
RESEND_API_KEY=
# The sender, like "Buildinio <hello@example.com>". Needs a domain verified in Resend.
# Left empty, it's onboarding@resend.dev, which only delivers to your own Resend account's email.
EMAIL_FROM=

# ── Your data ───────────────────────────────────────────────────────────────────

# The database: a SQLite file, created on first start.
DATABASE_PATH=data/buildinio.db
# Each project's code, one folder per project. Created on first use.
PROJECTS_PATH=data/projects
