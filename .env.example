# Copy to .env.local and fill in what you need. Everything is optional:
# without a value, that sign-in method (or the AI) shows a message instead.

# The public address, like https://buildinio.example.com. Used for OAuth callbacks and email links.
APP_URL=http://localhost:3000

# Where data is kept. Both are created on first start.
DATABASE_PATH=data/buildinio.db
PROJECTS_PATH=data/projects

# Google: https://console.cloud.google.com/apis/credentials (OAuth client ID, "Web application")
# Redirect URI: <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub: https://github.com/settings/developers (New OAuth App)
# Callback URL: <APP_URL>/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Email codes, sent with Resend: https://resend.com/api-keys
# Without a key, codes are printed in the server console.
RESEND_API_KEY=
# The sender, like "buildinio <hello@yourdomain.com>" (domain verified in Resend).
# Empty sends from onboarding@resend.dev, which only reaches your own Resend account's email.
EMAIL_FROM=

# The AI: an OpenAI model that supports the Responses API and function calling.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# none, minimal, low, medium, high, xhigh or max, depending on the model. Empty uses its default.
OPENAI_REASONING_EFFORT=medium
# Optional cheaper model for side jobs like naming projects. Empty uses the main model.
OPENAI_SMALL_MODEL=
OPENAI_SMALL_REASONING_EFFORT=

# Where the AI's commands run: docker (isolated container, default) or host (no isolation).
SANDBOX=docker
# Image for SANDBOX=docker. Empty uses Playwright's image matching playwright-core.
SANDBOX_IMAGE=
# For SANDBOX=host: the Chromium for screenshots. Empty downloads Playwright's on first use.
CHROMIUM_PATH=
