# Copy to .env (cp .env.example .env). Compose, the API dev server and Drizzle Kit read it.

# --- Development (pnpm db:up / pnpm dev) ---
# Host port of the dev database. Change it if 5432 is already in use.
DB_PORT=5432

# --- Sign-in (development and production) ---
# Signs sessions and cookies. Optional in development (a built-in default is used, with a
# warning); required in production. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Where people open the web app. Development default: http://localhost:3000
# BETTER_AUTH_URL=https://buildinio.example.com
# Google sign-in: create an OAuth client ID (type "Web application") in Google Cloud Console,
# APIs & Services > Credentials, with the authorized redirect URI
# <BETTER_AUTH_URL>/api/auth/callback/google (http://localhost:3000/api/auth/callback/google in
# development). Without both keys, "Continue with Google" says it isn't set up.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub sign-in: create an OAuth app in GitHub, Settings > Developer settings > OAuth Apps, with
# the authorization callback URL <BETTER_AUTH_URL>/api/auth/callback/github
# (http://localhost:3000/api/auth/callback/github in development), then generate a client secret.
# An OAuth app has one callback URL, so use one app for development and another for production.
# Without both keys, "Continue with GitHub" says it isn't set up.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Email sign-in (development and production) ---
# Sign-in codes are sent over SMTP, so any email provider works. Without SMTP_HOST and EMAIL_FROM,
# development prints the codes in the API's console instead, and production doesn't start.
#
# Brevo (free: 300 emails a day, no card needed):
#   1. Sign up at https://www.brevo.com.
#   2. Senders, Domains & Dedicated IPs > Domains: add your domain and add the DNS records it shows
#      (DKIM, DMARC), so the emails don't land in spam.
#   3. SMTP & API > SMTP: create an SMTP key. Use the login shown there as SMTP_USER and the key as
#      SMTP_PASSWORD.
# Other providers: Amazon SES (about $0.10 per 1,000 emails), Resend (free: 100 a day), Postmark.
# If the host blocks port 587, most providers also accept 2525 (Brevo) or 2587 (SES, Resend).
SMTP_HOST=
# 587 (STARTTLS, the default) or 465 (TLS).
# SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# The sender, at a domain set up with the provider, e.g. "Buildinio <no-reply@yourdomain.com>".
EMAIL_FROM=
# Brevo's settings, for example:
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_USER=123abc@smtp-brevo.com

# Codes: how long one works, wrong tries per code, and how long until another can be sent to the
# same email (less than the expiry). Defaults shown.
# EMAIL_CODE_EXPIRES_MINUTES=10
# EMAIL_CODE_MAX_TRIES=3
# EMAIL_CODE_RESEND_SECONDS=60
# Limits, as <count>/<window> with the window in s, m, h or d, several separated by commas, or
# "off". Defaults shown. A request over a limit is refused, and the page says how long to wait.
# Codes sent to one email (name+tag@ counts as name@):
# EMAIL_CODE_LIMIT_PER_EMAIL=5/1h,10/1d
# Requests for a code from one IP, and codes checked from one IP. They need the client's IP in
# X-Forwarded-For, set by a proxy in front of the web app (replacing any value the client sent);
# without it they are off.
# EMAIL_CODE_LIMIT_PER_IP=20/1h
# EMAIL_CODE_CHECK_LIMIT_PER_IP=30/15m
# All codes sent, a ceiling on email costs if someone gets around the other limits:
# EMAIL_CODE_LIMIT_TOTAL=500/1h

# --- Production (pnpm prod:up) ---
# Required. Use a strong password.
POSTGRES_PASSWORD=change-me
# Host port the web app is published on.
WEB_PORT=3000
