# Copy this file to .env.local and fill in what you need. Everything is optional:
# without a value, that sign-in method shows a message instead of working.

# Where the app runs. Used for the Google/GitHub callback address and the link in emails.
# Without it, the callback address comes from the request and emails have no link.
APP_URL=http://localhost:3000

# SQLite database file. Created on first start.
DATABASE_PATH=data/buildinio.db

# Google: https://console.cloud.google.com/apis/credentials (OAuth client ID, "Web application")
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub: https://github.com/settings/developers (New OAuth App)
# Authorization callback URL: http://localhost:3000/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Email codes are sent with Resend: https://resend.com/api-keys
# Without a key, codes are printed in the server console instead.
RESEND_API_KEY=
# The sender, like "buildinio <hello@yourdomain.com>". Needs a domain verified in Resend.
# Left empty, it's onboarding@resend.dev, which only delivers to your own Resend account's email.
EMAIL_FROM=
