# Copy this file to .env.local and fill in what you need. Everything is optional:
# without a value, that sign-in method (or the AI) shows a message instead of working.

# Where the app runs. Used for the Google/GitHub callback address and the link in emails.
# Without it, the callback address comes from the request and emails have no link.
APP_URL=http://localhost:3000

# SQLite database file. Created on first start.
DATABASE_PATH=data/buildinio.db

# Google: https://console.cloud.google.com/apis/credentials (OAuth client ID, "Web application")
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub: https://github.com/settings/developers (New OAuth App)
# Authorization callback URL: http://localhost:3000/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Email codes are sent with Resend: https://resend.com/api-keys
# Without a key, codes are printed in the server console instead.
RESEND_API_KEY=
# The sender, like "buildinio <hello@yourdomain.com>". Needs a domain verified in Resend.
# Left empty, it's onboarding@resend.dev, which only delivers to your own Resend account's email.
EMAIL_FROM=

# The AI that builds the apps: an OpenAI model. https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Any model that works with the Responses API and function calling.
OPENAI_MODEL=gpt-6-luna
# How hard it thinks, passed to OpenAI as is: none, minimal, low, medium, high, xhigh or max,
# depending on the model. Empty uses the model's default.
OPENAI_REASONING_EFFORT=medium
# Optional: a cheaper model (and its effort) for quick side jobs, like naming a new project.
# Empty uses the main model.
OPENAI_SMALL_MODEL=
OPENAI_SMALL_REASONING_EFFORT=

# Where the AI runs npm and other commands for each app.
# docker (default): a throwaway node container that only sees the app's folder. Needs Docker running.
# host: right on this computer, with nothing secret in its environment. No setup, but no isolation either.
SANDBOX=docker
# The container image for SANDBOX=docker. Empty uses Playwright's image matching playwright-core
# (Node, npm and Chromium, for the AI's screenshots). An image without Chromium, like node:22-slim,
# works too, but then the AI can't look at the apps it builds.
SANDBOX_IMAGE=
# For SANDBOX=host: the Chromium for screenshots. Empty uses Playwright's (npx playwright install chromium).
CHROMIUM_PATH=

# Where each project's code is kept, one folder per project. Created on first use.
PROJECTS_PATH=data/projects
